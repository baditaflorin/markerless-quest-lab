{
  "name": "markerless-quest-lab-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && VITE_STATIC_DEMO=true vite build --base=/markerless-quest-lab/",
